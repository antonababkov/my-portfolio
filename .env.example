# ============================================================
# Пример конфигурации для деплоя через docker-compose.
# Скопируйте в .env на сервере и заполните реальными значениями.
# НИКОГДА не коммитьте реальный .env.
# ============================================================

# --- PostgreSQL (контейнер db) ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=portfolio
DATABASE_URL=your_database_url

# --- Админ-доступ, создаётся при первом seed ---
AUTH_ADMIN_LOGIN=admin
AUTH_ADMIN_PASSWORD=replace-with-strong-password

# --- Секрет для JWT (обязателен, сгенерируйте: openssl rand -hex 64) ---
AUTH_SECRET=replace-with-64-hex-chars

# --- Публичный URL сайта (для canonical/OG) ---
SITE_URL=https://example.com