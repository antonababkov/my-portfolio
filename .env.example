# ============================================================
# Пример конфигурации для деплоя через docker-compose.
# Скопируйте в .env на сервере и заполните реальными значениями.
# НИКОГДА не коммитьте реальный .env.
# ============================================================

# --- PostgreSQL (контейнер db) ---
# Пароль должен быть URL-safe либо URL-encoded: compose собирает
# DATABASE_URL из POSTGRES_PASSWORD, и символы @ : / # % ломают URL.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=portfolio
# Для локальной разработки. В docker compose DATABASE_URL собирается
# автоматически из POSTGRES_* и указывает на хост db.
DATABASE_URL=postgresql://portfolio:replace-with-strong-password@localhost:5432/portfolio

# --- Админ-доступ, создаётся при первом seed ---
AUTH_ADMIN_LOGIN=admin
AUTH_ADMIN_PASSWORD=replace-with-strong-password

# --- Секрет для JWT (обязателен, сгенерируйте: openssl rand -hex 64) ---
AUTH_SECRET=replace-with-64-hex-chars

# --- Публичный URL сайта (для canonical/OG), обязателен в production ---
SITE_URL=https://ababkov-ao.ru

# --- Яндекс.Метрика (счётчик загружается только после согласия в баннере) ---
# ID счётчика из панели Метрики. Пусто — аналитика отключена (рекомендуется для dev).
NEXT_PUBLIC_METRIKA_ID=